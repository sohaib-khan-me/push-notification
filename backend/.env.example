# Copy to .env and edit. Never commit .env.
# Absolute path to your Firebase Admin SDK key (keep it OUTSIDE this repository).
GOOGLE_APPLICATION_CREDENTIALS=/home/YOUR_USERNAME/.config/fcm-push-notifications/service-account.json
# Browser origins allowed to call this API (comma separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: where the SQLite file lives.
# DATABASE_PATH=./data/push.db
